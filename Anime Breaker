-- Load saved account configuration into State
function AccountSave.Load()
    if not (isfile and readfile) then return end
    pcall(function()
        if isfile(accountFileName) then
            local raw = readfile(accountFileName)
            if raw and raw ~= "" then
                local data = HttpService:JSONDecode(raw)
                if type(data) == "table" then
                    for k, v in pairs(data) do
                        if State[k] ~= nil then
                            State[k] = v
                        end
                    end
                end
            end
        end
    end)
end

-- Save current State to account file
local lastSavedHash = ""
function AccountSave.Save()
    if AccountSave.IsSyncing or not (writefile and isfolder) then return end
    pcall(function()
        local saveTable = {}
        for k, v in pairs(State) do
            local t = typeof(v)
            if t == "boolean" or t == "number" or t == "string" then
                saveTable[k] = v
            end
        end
        local encoded = HttpService:JSONEncode(saveTable)
        if encoded ~= lastSavedHash then
            writefile(accountFileName, encoded)
            lastSavedHash = encoded
        end
    end)
end

