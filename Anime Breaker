-- Suppress "Your Best X have been Equipped!" in-game notification spam
local function HandleEquipNotification(child)
    if not child or not child:IsA("GuiObject") then return end
    local function check()
        local label = child:FindFirstChild("Label", true)
        if label and label.Text and (label.Text:find("have been Equipped") or label.Text:find("Equipped!")) then
            child.Visible = false
            child.Size = UDim2.fromScale(0, 0)
            child.Position = UDim2.fromScale(-10, -10)
            local main = child:FindFirstChild("Main")
            if main then main.Visible = false end
            return true
        end
        return false
    end

    if not check() then
        local conn
        conn = child.DescendantAdded:Connect(function(desc)
            if desc:IsA("TextLabel") then
                if check() and conn then
                    conn:Disconnect()
                else
                    desc:GetPropertyChangedSignal("Text"):Connect(function()
                        if check() and conn then
                            conn:Disconnect()
                        end
                    end)
                end
            end
        end)
        task.defer(check)
    end
end

