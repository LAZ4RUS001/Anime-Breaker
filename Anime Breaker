-- ตรวจจับ Area / แผนที่ที่ตัวละครยืนอยู่ ณ ปัจจุบัน
local function GetCurrentArea()
    local inMode = LocalPlayer:GetAttribute("InMode")
    local mode = LocalPlayer:GetAttribute("Mode")
    local isInsideRaid = (mode == "Raid") or (inMode and tostring(inMode):find("Raid"))
    if isInsideRaid or (mode ~= nil and mode ~= "") then
        return "Gamemode"
    end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return "All" end
    local p = root.Position

    -- 1. ตรวจสอบจาก Zone Part ของแต่ละ Map ใน workspace._MAP
    local mapFolder = workspace:FindFirstChild("_MAP")
    if mapFolder then
        for _, map in ipairs(mapFolder:GetChildren()) do
            local zone = map:FindFirstChild("Zone")
            if zone and zone:IsA("BasePart") then
                local c = zone.Position
                local s = zone.Size
                local minX, maxX = c.X - (s.X / 2) - 30, c.X + (s.X / 2) + 30
                local minZ, maxZ = c.Z - (s.Z / 2) - 30, c.Z + (s.Z / 2) + 30
                if p.X >= minX and p.X <= maxX and p.Z >= minZ and p.Z <= maxZ then
                    return map.Name
                end
            end
        end
    end

    -- 2. Fallback: ค้นหาจากโฟลเดอร์ม็อบที่อยู่ใกล้ที่สุดใน _ENEMIES.Server
    local serverFolder = workspace:FindFirstChild("_ENEMIES") and workspace._ENEMIES:FindFirstChild("Server")
    if serverFolder then
        local closestDist = math.huge
        local closestArea = nil
        for _, folder in ipairs(serverFolder:GetChildren()) do
            if folder.Name ~= "Gamemode" and folder.Name ~= "GlobalBoss" then
                for _, mob in ipairs(folder:GetChildren()) do
                    if mob:IsA("BasePart") then
                        local d = (p - mob.Position).Magnitude
                        if d < closestDist then
                            closestDist = d
                            closestArea = folder.Name
                        end
                    end
                end
            end
        end
        if closestArea and closestDist < 1200 then
            return closestArea
        end
    end

    return "All"
end

-- สแกนหารายชื่อมอนสเตอร์ทั้งหมดใน Area นั้นๆ
local function GetAreaMobList(areaName)
    local mobNames = {}
    local seen = {}
    local serverFolder = workspace:FindFirstChild("_ENEMIES") and workspace._ENEMIES:FindFirstChild("Server")
    if not serverFolder then return {} end

    local targetFolder = (areaName and areaName ~= "All" and areaName ~= "Auto (ตามพื้นที่ปัจจุบัน)") and serverFolder:FindFirstChild(areaName)
    if targetFolder then
        for _, mob in ipairs(targetFolder:GetChildren()) do
            if mob:IsA("BasePart") then
                local name = mob:GetAttribute("Name") or mob.Name
                if name and not seen[name] then
                    seen[name] = true
                    table.insert(mobNames, name)
                end
            end
        end
    else
        -- ถ้าเลือก All ให้ดึงมอนสเตอร์จากทุกแมพปกติ
        for _, folder in ipairs(serverFolder:GetChildren()) do
            if folder.Name ~= "Gamemode" and folder.Name ~= "GlobalBoss" then
                for _, mob in ipairs(folder:GetChildren()) do
                    if mob:IsA("BasePart") then
                        local name = mob:GetAttribute("Name") or mob.Name
                        if name and not seen[name] then
                            seen[name] = true
                            table.insert(mobNames, name)
                        end
                    end
                end
            end
        end
    end

    table.sort(mobNames)
    return mobNames
end

-- Find enemies based on map filter and sorting mode
local function GetTargetEnemies()
    local inMode = LocalPlayer:GetAttribute("InMode")
    local mode = LocalPlayer:GetAttribute("Mode")
    local isInsideRaid = (mode == "Raid") or (inMode and tostring(inMode):find("Raid"))

    -- ถ้าอยู่ในโหมด Raid หรือมี Gamemode กำลังรันอยู่ จะไม่ค้นหามอนสเตอร์โลกปกติเพื่อป้องกันการวาปสลับโลก
    if isInsideRaid or (mode ~= nil and mode ~= "") then
        return {}
    end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local myPos = root and root.Position or Vector3.zero

    local enemiesFolder = workspace:FindFirstChild("_ENEMIES")
    local serverFolder = enemiesFolder and enemiesFolder:FindFirstChild("Server")
    if not serverFolder then return {} end

    -- ระบุ Map ที่ต้องการฟาร์ม: อัตโนมัติตาม Area ปัจจุบัน หรือตามที่ผู้ใช้เลือกใน Dropdown
    local currentArea = GetCurrentArea()
    local targetMap = nil
    if State.SelectedMap and State.SelectedMap ~= "All" and State.SelectedMap ~= "Auto (ตามพื้นที่ปัจจุบัน)" then
        targetMap = State.SelectedMap
    elseif State.SelectedMap == "Auto (ตามพื้นที่ปัจจุบัน)" then
        if currentArea and currentArea ~= "All" and currentArea ~= "Lobby" and currentArea ~= "Gamemode" then
            targetMap = currentArea
        end
    end

    local candidates = {}

    for _, mapFolder in ipairs(serverFolder:GetChildren()) do
        -- อย่าเอามอนสเตอร์จาก Gamemode หรือ GlobalBoss เข้ามารวมกับการฟาร์มโลกปกติ
        if mapFolder.Name ~= "Gamemode" and mapFolder.Name ~= "GlobalBoss" then
            if not targetMap or targetMap == mapFolder.Name then
                for _, mob in ipairs(mapFolder:GetChildren()) do
                    if mob:IsA("BasePart") then
                        local dead = mob:GetAttribute("Dead")
                        local hp = mob:GetAttribute("HP") or 0
                        local mobName = mob:GetAttribute("Name") or mob.Name

                        -- กรองมอนสเตอร์ตามเป้าหมายที่เลือก: ถ้าเลือกชื่อมอนสเตอร์เจาะจง จะตีเฉพาะตัวนั้น
                        local isMobMatch = true
                        local tMode = State.TargetMode or "Closest (ใกล้สุด)"
                        if tMode ~= "Closest" and tMode ~= "Closest (ใกล้สุด)" and tMode ~= "All" and tMode ~= "All (ทุกตัว)" and tMode ~= "HighestHP" and tMode ~= "Highest HP" and tMode ~= "LowestHP" and tMode ~= "Lowest HP" then
                            if mobName ~= tMode then
                                isMobMatch = false
                            end
                        end

                        if dead ~= true and hp > 0 and isMobMatch then
                            local dist = (myPos - mob.Position).Magnitude
                            if dist <= State.FarmRange then
                                table.insert(candidates, {
                                    part = mob,
                                    uid = mob.Name,
                                    name = mobName,
                                    map = mapFolder.Name,
                                    hp = hp,
                                    maxHp = mob:GetAttribute("MaxHP") or hp,
                                    dist = dist,
                                    pos = mob.Position
                                })
                            end
                        end
                    end
                end
            end
        end
    end

    if State.TargetMode == "HighestHP" or State.TargetMode == "Highest HP" then
        table.sort(candidates, function(a, b) return a.hp > b.hp end)
    elseif State.TargetMode == "LowestHP" or State.TargetMode == "Lowest HP" then
        table.sort(candidates, function(a, b) return a.hp < b.hp end)
    else
        table.sort(candidates, function(a, b) return a.dist < b.dist end)
    end

    return candidates
end

