-- 17. BUTTERY SMOOTH OPEN/CLOSE ANIMATION & PREMIUM MOBILE TOGGLE BUTTON
local ToggleHubSmooth
do
    local root = Window.Root
    local uiScale = root:FindFirstChild("StreetHubUIScale")
    if not uiScale then
        uiScale = Instance.new("UIScale")
        uiScale.Name = "StreetHubUIScale"
        uiScale.Scale = 1.0
        uiScale.Parent = root
    end

    local isToggling = false
    local isWindowOpen = true

    ToggleHubSmooth = function()
        if isToggling then return end
        isToggling = true

        if isWindowOpen then
            -- Smooth Close: Scale down gracefully
            local tweenClose = TweenService:Create(uiScale, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Scale = 0.88
            })
            tweenClose:Play()
            tweenClose.Completed:Connect(function()
                root.Visible = false
                isWindowOpen = false
                Window.Minimized = true
                isToggling = false
            end)
        else
            -- Smooth Open: Appear slightly scaled down and spring smoothly to full size
            root.Visible = true
            uiScale.Scale = 0.88
            isWindowOpen = true
            Window.Minimized = false

            local tweenOpen = TweenService:Create(uiScale, TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Scale = 1.0
            })
            tweenOpen:Play()
            tweenOpen.Completed:Connect(function()
                uiScale.Scale = 1.0
                isToggling = false
            end)
        end
    end

    -- Hook Fluent Window:Minimize to use our smooth animation
    Window.Minimize = function(self)
        ToggleHubSmooth()
    end
end


-- Helper to load StreetHub Custom Logo from embedded base64 or fallback
local function GetStreetHubLogo()
    local fileName = "streethub_logo.png"
    local getAsset = getcustomasset or getsynasset
    if not getAsset then
        return "rbxassetid://10734975486"
    end
    local ok, res = pcall(function()
        local exists = false
        pcall(function()
            if isfile and isfile(fileName) then
                exists = true
            end
        end)
        if not exists and writefile then
            local b64Data = ""
            local decoded = nil
            pcall(function()
                if crypt and crypt.base64decode then
                    decoded = crypt.base64decode(b64Data)
                elseif base64_decode then
                    decoded = base64_decode(b64Data)
                elseif base64 and base64.decode then
                    decoded = base64.decode(b64Data)
                end
            end)
