-- Helper function to teleport directly to stand beside mob during Raid (Jitter-free & anti-screen-shake)
local lastRaidTargetId = nil
local lastRaidTPTime = 0

local function RaidTeleportToMob(mobPart)
    local inMode = LocalPlayer:GetAttribute("InMode")
    local mode = LocalPlayer:GetAttribute("Mode")
    local isInsideRaidMatch = (mode == "Raid") or (mode == "Invasion") or (mode == "Time Trial")
    if not isInsideRaidMatch then return end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or not mobPart then return end

    -- ป้องกันการวาปข้ามโลก: ตรวจสอบเด็ดขาดว่า mobPart อยู่ใต้โฟลเดอร์ Gamemode ใน _ENEMIES
    local gmFolder = workspace:FindFirstChild("_ENEMIES") and workspace._ENEMIES:FindFirstChild("Server") and workspace._ENEMIES.Server:FindFirstChild("Gamemode")
    if not gmFolder or not mobPart:IsDescendantOf(gmFolder) then
        return
    end

    local mobId = mobPart.Name
    local pos = mobPart.Position
    local dist = State.RaidStandDistance or 4

    local myPos = root.Position
    local horizontalDist = (Vector3.new(myPos.X, 0, myPos.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude

    -- ป้องกันจอสั่น: ถ้ากำลังตีมอนตัวเดิมอยู่แล้ว และยืนอยู่ในระยะตี (ห่างไม่เกินระยะยืน + 3 studs)
    -- จะไม่ทำการเซ็ต CFrame ซ้ำๆ เพื่อไม่ให้ Physics กับกล้องตีกันจนเกิดอาการกระตุก/สั่น
    if lastRaidTargetId == mobId and horizontalDist <= (dist + 3) and (os.clock() - lastRaidTPTime) < 15 then
        root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
        root.AssemblyAngularVelocity = Vector3.zero
        return
    end

    -- ยิง Raycast หาพื้นดินจริง เพื่อให้เท้าวางบนพื้นพอดี ไม่จมลงไปในพื้นจนโดนระบบฟิสิกส์ดีดขึ้น
    local groundY = root.Position.Y
    pcall(function()
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {char, workspace:FindFirstChild("_ENEMIES")}
        local rayOrigin = pos + Vector3.new(0, 10, 0)
        local rayResult = workspace:Raycast(rayOrigin, Vector3.new(0, -35, 0), rayParams)
        if rayResult and rayResult.Position then
            groundY = rayResult.Position.Y + 3.0
        end
    end)

    -- คำนวณตำแหน่งยืนข้างตัวมอนสเตอร์ (RightVector)
    local offsetDir = mobPart.CFrame.RightVector
    if offsetDir.Magnitude < 0.1 then
        offsetDir = Vector3.new(1, 0, 0)
    end

    local standPos = Vector3.new(pos.X + (offsetDir.X * dist), groundY, pos.Z + (offsetDir.Z * dist))
    local lookTarget = Vector3.new(pos.X, groundY, pos.Z)
    local targetCFrame = CFrame.lookAt(standPos, lookTarget)

    pcall(function()
        root.CFrame = targetCFrame
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.PlatformStand = false
        end
    end)

    lastRaidTargetId = mobId
    lastRaidTPTime = os.clock()
end

-- ระบบกด Return ออกจาก Raid ทันที: ทำงานทุกกรณี ไม่ว่าจะชนะ, แพ้, หมดเวลา, เคลียร์ดันเจี้ยน, หรือกดออกตาม Wave
