-- Auto Join Public Raid & Scheduled Event Logic
local function TryJoinPublicRoom(room)
    if not room or not room:IsA("Folder") then return false end
    local inMode = LocalPlayer:GetAttribute("InMode")
    local mode = LocalPlayer:GetAttribute("Mode")
    if inMode or mode then return false end

    local modeId = room:GetAttribute("ModeId")
    local hostId = room:GetAttribute("HostId")
    local isPrivate = room:GetAttribute("Private")
    local mapId = room:GetAttribute("MapId")
    local status = room:GetAttribute("Status")

    if hostId and hostId ~= LocalPlayer.UserId and isPrivate ~= true and status ~= "Running" then
        if State.JoinMapFilter == "AllMap" or State.JoinMapFilter == "Any" or State.JoinMapFilter == "All" or State.JoinMapFilter == mapId then
            if modeId == "Raid" and State.AutoJoinPublicRaid then
                Remote:Fire("GamemodeSystem", "Join", modeId, hostId)
                task.wait(0.2)
                Remote:Fire("GamemodeSystem", "Follow", modeId, true, hostId)
                SafeNotify("Street Hub", "Joined " .. tostring(mapId) .. " Raid Room!", 3)
                return true
            elseif (modeId == "Invasion" or modeId == "Time Trial" or modeId == "Portal") and State.AutoJoinScheduledEvent then
                Remote:Fire("GamemodeSystem", "Join", modeId, hostId)
                task.wait(0.2)
                Remote:Fire("GamemodeSystem", "Follow", modeId, true, hostId)
                SafeNotify("Street Hub", "Joined " .. tostring(modeId) .. " Room!", 3)
                return true
            end
        end
    end
    return false
end

